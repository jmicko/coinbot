### Postgres
PGHOST=localhost
PGUSER=coinbot
PGPASSWORD=coinbot
PGDATABASE=coinbot_dev
PGPORT=5432

### Session
SERVER_SESSION_SECRET=replace-this-local-dev-secret

### Node
NODE_ENV=development

### VAPID keys
# Leave blank unless you are testing push notifications.
# The notifications route will log generated keys when these are missing.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

### Domain name needed for VAPID
# Must be an https: or mailto: URL for web-push VAPID subject validation.
DOMAIN_NAME=https://localhost.local

### Misc
# SAMPLE_ORDER_ID is only occasionally used to identify a specific order in development logs.
SAMPLE_ORDER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
